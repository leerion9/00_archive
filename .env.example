ARCHIVE_BASE_DIR=data/naver_daily_archive
ARCHIVE_WORKER_ID=pc
ARCHIVE_DELAY_SEC=0.08
ARCHIVE_JITTER_SEC=0.03
ARCHIVE_BATCH_SIZE=50
ARCHIVE_BATCH_PAUSE_SEC=3.0
ARCHIVE_MAX_TASKS_PER_RUN=150
ARCHIVE_MAX_PAGES_PER_YEAR_TASK=30
ARCHIVE_NUM_CHUNKS=4
# ARCHIVE_CHUNK_ID=0
ARCHIVE_PC_YEAR_MIN=
ARCHIVE_YEAR_FROM=2000
ARCHIVE_YEAR_TO=2026
ARCHIVE_END_DATE=20260531
SYMBOL_MASTER_PATH=data/kr_symbol_master.json

# pykrx 시가총액 (Step C) — KRX 정보데이터시스템(data.krx.co.kr) 로그인
KRX_ID=
KRX_PW=

# OpenDART 재무 (fundamentals) — opendart.fss.or.kr 인증키(crtfc_key)
# ※ KRX_ID/KRX_PW 와 다름. 일일 한도 40,000 → soft 35,000에서 중단.
DART_API_KEY=
DART_DAILY_HARD_LIMIT=40000
DART_DAILY_SOFT_LIMIT=35000
DART_DELAY_SEC=0.15
